# VLM Provider Strategy
# Options: openai, anthropic, ollama, mock
VLM_PROVIDER=openai
MODEL_NAME=gpt-4o-mini

# OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API Settings
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Ollama / Local VLM Settings
OLLAMA_BASE_URL=http://localhost:11434

# Application Configuration
APP_NAME=Visual Question Answering API
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Audit & Storage Settings
AUDIT_LOG_PATH=audit.log

# Image Processing & Request Limits
MAX_IMAGE_DIMENSION=1024
REQUEST_TIMEOUT=60.0

# Prompt Engineering for Visual Grounding
SYSTEM_PROMPT=You are a visually grounded AI assistant. Answer the user's question accurately based ONLY on the provided image. Be concise. If the question asks for a count or number, reply with only the numerical digit.

